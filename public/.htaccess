# ============================================================================
# Neuromundi — .htaccess para Hostinger (Apache)
# Colócalo en public_html/ junto al index.html de tu dist/.
# Cubre: forzar HTTPS, ruteo de la SPA (React Router), compresión y caché.
# ============================================================================

# --- 1) Forzar HTTPS (obligatorio: el cifrado E2E y la PWA lo requieren) -----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonicaliza el dominio a www (neuromundi.com -> www.neuromundi.com).
  # CLAVE para el login social (OAuth/PKCE): Supabase guarda el `code_verifier`
  # en el localStorage del host donde INICIA el login y debe leerlo en el MISMO
  # host al volver. Si el usuario saltara entre apex y www a mitad del flujo, la
  # sesión no se crea (síntoma: "acepto en Microsoft pero no queda la sesión").
  # Se acota al apex exacto para no tocar otros subdominios (p. ej. admin.*).
  RewriteCond %{HTTP_HOST} ^neuromundi\.com$ [NC]
  RewriteRule ^ https://www.neuromundi.com%{REQUEST_URI} [L,R=301]

  # Redirige http -> https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- 2) Ruteo de la SPA: todo lo que no sea archivo/carpeta real -> index.html
<IfModule mod_rewrite.c>
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Colisión ruta-SPA vs carpeta física: /kit (PDFs del kit) y /tribu (logo de
  # Neurocamps) existen como CARPETAS en el disco, así que la regla genérica de
  # abajo (!-d) las saltaría y Apache devolvería 403 (carpeta sin índice) — eso
  # rompía /kit en Google (error de indexación). Forzamos que EXACTAMENTE esas
  # rutas (con o sin barra) sirvan la SPA; los archivos internos (/kit/…​.pdf,
  # /tribu/…​.webp) siguen sirviéndose normal porque no coinciden con ^ruta/?$.
  DirectorySlash Off
  RewriteRule ^(kit|tribu)/?$ /index.html [L]

  # IMPORTANTE: si falta un archivo dentro de /assets/ (p. ej. un chunk con hash
  # viejo tras un nuevo despliegue), devolver un 404 REAL en vez de index.html.
  # Si se reescribiera a index.html, el navegador recibiría HTML donde espera JS
  # y fallaría con "Failed to fetch dynamically imported module".
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/ - [R=404,L]

  # SEO: snapshot por RUTA. Si existe dist/<ruta>.html (generado por
  # gen-seo-langs.mjs con su canónica/título propios) y la URL es de UN solo
  # segmento que no es archivo/carpeta real, servir ese snapshot en vez de la
  # portada. Así Googlebot ve la canónica correcta de cada página profunda sin
  # depender de JS (antes las tomaba como duplicadas de la home). Si no hay
  # snapshot, la ruta cae a la SPA (regla de abajo). Las carpetas físicas
  # (/en, /kit, /tribu) no entran aquí porque son -d.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ /$1.html [L]

  # El resto de rutas (de la SPA) sí van a index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- 3) Compresión (acelera la carga) ----------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- 4) Caché -----------------------------------------------------------------
# Los archivos de /assets/ llevan hash en el nombre: se pueden cachear mucho.
# index.html y el service worker NO deben cachearse, para que las
# actualizaciones se vean de inmediato.
<IfModule mod_headers.c>
  # ORDEN IMPORTANTE: en Apache la última directiva que coincide gana, así que
  # primero va la regla amplia y DESPUÉS las excepciones. Si se invirtiera,
  # sw.js caería en la regla de un año y las actualizaciones de la PWA no
  # llegarían nunca a los usuarios.

  # 1) Estáticos con hash o versión en el nombre (-v2): un año es seguro,
  #    porque si el contenido cambia, cambia la URL.
  #    Se usa mod_headers y no solo mod_expires: si ese módulo no está activo en
  #    el plan, su bloque se ignora EN SILENCIO y los archivos salen sin
  #    Cache-Control (eso explicaba el "TTL: None" del video .webm).
  <FilesMatch "\.(css|webp|png|jpe?g|svg|ico|woff2?|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 2) El JS con hash de Vite vive en /assets/ y también se cachea un año.
  <FilesMatch "^.*\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 3) EXCEPCIONES (van al final para imponerse): lo que anuncia una versión
  #    nueva de la app siempre debe REVALIDARSE. Usamos `no-cache` (revalida en
  #    cada carga con ETag), NO `no-store`: `no-store` impide el back/forward
  #    cache (bfcache) del navegador —lo marcaba Lighthouse— sin ninguna ventaja,
  #    porque `no-cache, must-revalidate` ya evita servir HTML/SW viejos.
  <FilesMatch "(\.html|sw\.js|registerSW\.js|push-sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Assets con hash (JS, CSS, imágenes, fuentes): un año
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  # HTML: sin caché (lo controla el bloque de Headers de arriba)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- 5) Tipos MIME por si el servidor no los reconoce ------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js
  AddType image/svg+xml .svg
</IfModule>

# --- 6) Cabeceras de seguridad -----------------------------------------------
# Las marca PageSpeed/Lighthouse (Prácticas recomendadas). Se usan `always` para
# que apliquen también a respuestas de error.
<IfModule mod_headers.c>
  # HSTS: el sitio ya fuerza HTTPS; fija el navegador a HTTPS por 1 año.
  # includeSubDomains asume que TODOS los subdominios (p. ej. admin.*) sirven
  # HTTPS —que es el caso—. Sin `preload` a propósito (es un compromiso mayor).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Evita el "MIME sniffing" (no interpretar un archivo como otro tipo).
  Header always set X-Content-Type-Options "nosniff"

  # No filtrar la URL completa como referer a terceros.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Anti-clickjacking: la página no puede incrustarse en iframes ajenos.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Aislamiento de origen (COOP). unsafe-none no aplica; same-origin aísla.
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Desactiva APIs potentes que la app NO usa en su propio origen (la geo se hace
  # por IP, no por la API del navegador; las videoconsultas abren meet.jit.si en
  # navegación, no en iframe, así que cámara/micrófono no se usan en este origen).
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), browsing-topics=()"

  # CSP: orígenes acotados a lo que la app realmente carga. object-src 'none',
  # base-uri y frame-ancestors 'self' son la protección anti-XSS/clickjacking.
  # `'unsafe-inline'` en script-src es necesario por los scripts en línea del
  # index.html (precarga del héroe, arranque de gtag) y el onload de la hoja de
  # fuentes. Si algo se bloqueara, cambia temporalmente el nombre de esta cabecera
  # a `Content-Security-Policy-Report-Only` para diagnosticar sin romper.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://ipwho.is https://www.google-analytics.com https://www.googletagmanager.com; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
