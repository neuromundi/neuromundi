# ── Frontend (Vite) — necesarias para compilar y correr la app ───────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_NAME="NeuroDirectorio"
VITE_APP_VERSION=1.0.0
# Clave pública VAPID para notificaciones push nativas (igual a VAPID_PUBLIC_KEY
# del backend). Genera el par con:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# API key de CARTO Basemaps (mapa del directorio). Sin ella los tiles salen con
# marca de agua "API KEY REQUIRED". Gratis hasta 5M peticiones/mes:
# https://carto.com/basemaps/apikey
VITE_CARTO_KEY=

# ── Edge Functions (NO van en el .env del front; se configuran como secrets) ──
# supabase secrets set RESEND_API_KEY=...
#   RESEND_API_KEY                 API key de Resend (función send-support)
#   SUPPORT_TO                     destinatario (def. admin@neuromundi.com)
#   SUPPORT_FROM                   remitente verificado en Resend
#   VAPID_PUBLIC_KEY               push nativo (= VITE_VAPID_PUBLIC_KEY del front)
#   VAPID_PRIVATE_KEY              push nativo (secreto; función send-push)
#   VAPID_SUBJECT                  p. ej. mailto:admin@neuromundi.com
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY las inyecta
# Supabase automáticamente en las Edge Functions; no las pongas aquí.
